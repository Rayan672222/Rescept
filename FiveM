  --text:#eef4ff; --muted:#8fa0c8; --bgimg:radial-gradient(800px 480px at 90% -6%,color-mix(in srgb,var(--accent) 32%,transparent),transparent 60%),radial-gradient(600px 400px at 0% 55%,color-mix(in srgb,var(--accent2) 8%,transparent),transparent 60%); --bw:1px; --sh:none; --navr:20px; --pad:16px; --inset:#070e22; --on:#04222b; --r:22px; --live:#ff5d73; --ok:#3ecf8e; --warn:#f5b84b;
