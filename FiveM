  else if(a.dataset.act==='appadd'){const n=document.getElementById('ap_n').value.trim();if(!n)return alert0('اكتب اسم التطبيق');const ap={id:Date.now().toString(36),n,col:hx(document.getElementById('ap_c').value),ico:S.appImg?'':(S.appIco||'#s0'),img:S.appImg||''};await saveSite({apps:[...(S.site.apps||[]),ap]});S.appN=S.appC=S.appIco=S.appImg='';render()}
