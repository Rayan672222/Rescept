.hero{border-radius:calc(var(--r) + 4px);border:1px solid var(--line);background:linear-gradient(160deg,color-mix(in srgb,var(--accent) 30%,transparent),color-mix(in srgb,var(--surface) 90%,transparent) 60%);padding:34px 22px;text-align:start;display:flex;flex-direction:column;align-items:flex-start;gap:10px;position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;inset-inline-end:-60px;top:-60px;width:220px;height:220px;border-radius:50%;border:2px solid color-mix(in srgb,var(--accent) 35%,transparent);box-shadow:0 0 0 22px color-mix(in srgb,var(--accent) 6%,transparent),0 0 0 48px color-mix(in srgb,var(--accent) 4%,transparent)}
