const VIEWS={tickets:vTickets,chat:vChat,home:vHome,channels:vChannels,alerts:vAlerts,account:vAccount,admin:vAdmin};
function softRender(){if(S._skip)S._pending=true;else render()}
function render(){
 applyTheme();
 const keep=document.activeElement;if(keep&&/INPUT|TEXTAREA|SELECT/.test(keep.tagName)&&keep.closest('form')&&S._skip){S._pending=true;return}
 const n=unread(),r=S.route;
 $('#app').innerHTML=`<header class="top"><button class="ib" data-go="alerts" aria-label="التنبيهات">${svg('bell')}${n?`<b>${n>9?'9+':n}</b>`:''}</button>${tbHtml()}<div class="brand"><b>${S.site.name?esc(S.site.name):'RESPECT <i>LIVE</i>'}</b><small>${esc(S.site.sub||'STREAM MONITOR · OFFICIAL')}</small>${admChip()}</div><div class="logo">${imgOk(S.site.logo)?`<img src="${esc(S.site.logo)}" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:inherit">`:'<svg viewBox="0 0 24 24"><path d="M21 4L3 11l5 2 2 6 3-4 5 4z" fill="var(--on)"/></svg>'}</div></header>
 <main style="display:flex;flex-direction:column;gap:16px">${annHtml()}${S.site.maint&&r!=='admin'&&!isStaff()?`<div class="card" style="text-align:center;padding:40px 16px"><h2 style="justify-content:center">🛠️ الموقع تحت الصيانة</h2><div class="muted">${esc(S.site.maint)}</div></div>`:VIEWS[r]()}</main>
 <nav class="bn">${NAVT().map(([k,l])=>`<a href="#${k}" class="${r===k?'on':''}">${navIco(k)}<span>${l}</span></a>`).join('')}</nav>`;
 const mm=$('#msgs');if(mm)mm.scrollTop=mm.scrollHeight;
}
function go(k){S.route=ROUTES.includes(k)?k:'home';if(S.route==='alerts'){store.set('rl_seen',Date.now())}render();scrollTo(0,0)}
addEventListener('hashchange',()=>{const h=location.hash.slice(1);const cur=S.route;S.route=ROUTES.includes(h)&&(h==='admin'||!(S.site.hidden||[]).includes(h))?h:'home';if(S.route==='alerts'&&cur!=='alerts'){const s=seenAt();S._prevSeen=s;store.set('rl_seen',Date.now())}render()});

/* ---------- events ---------- */
document.addEventListener('click',async e=>{
 const g=e.target.closest('[data-go]');if(g){location.hash=g.dataset.go;return}
