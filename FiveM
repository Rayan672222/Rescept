  else if(a.dataset.act==='cperm'){const c={...(S.site.chat||{})},w=a.dataset.w,l=(c[w]||[]).slice(),j=l.indexOf(a.dataset.k);j<0?l.push(a.dataset.k):l.splice(j,1);c[w]=l;await saveSite({chat:c})}
  else if(a.dataset.act==='cclr'){await saveSite({chat:{}})}
