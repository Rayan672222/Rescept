const left=ms=>{const m=Math.max(1,Math.ceil(ms/6e4));return m>=1440?Math.ceil(m/1440)+' يوم':m>=60?Math.ceil(m/60)+' ساعة':m+' دقيقة'};
const muted=()=>S.acct&&S.acct.mute>Date.now(),banned=()=>S.acct&&S.acct.ban;
async function addWarn(id,a,r){const w=[...(a.warns||[]),{r,at:Date.now()}],n=+(S.site.aw||3),u={warns:w};let ex='';if(n&&w.length%n===0){u.mute=Date.now()+(+(S.site.am||60))*6e4;ex=' + كتم تلقائي'}await S.db.doc('accounts/'+id).update(u);LOG('⚠️ تحذير @'+id+': '+r+ex)}
async function drawG(g){const p=(g.entries||[]).slice().sort(()=>Math.random()-.5).slice(0,g.winners||1);await S.db.doc('giveaways/'+g.id).update({done:true,won:p});LOG('🏆 سحب «'+g.prize+'»: '+(p.map(x=>'@'+x).join('، ')||'ما في مشاركين'));if(p.length)await S.db.collection('alerts').add({kind:'post',text:'🎁 فاز بـ «'+g.prize+'»: '+p.map(x=>'@'+x).join('، '),at:Date.now()})}
