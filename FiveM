  else if(a.dataset.act==='delch'){await S.db.doc('channels/'+id).delete()}
  else if(a.dataset.act==='delal'){await S.db.doc('alerts/'+id).delete()}
  else if(a.dataset.act==='atab'){S.atab=a.dataset.k;render()}
  else if(a.dataset.act==='ipick'){S.pick=a.dataset.k;render()}
  else if(a.dataset.act==='iset'&&S.pick){await saveSite({icons:{...(S.site.icons||{}),[S.pick]:(a.dataset.s==='1'?'#s':'#i')+a.dataset.n}})}
  else if(a.dataset.act==='iauto'){const o={};SL.forEach(([k],j)=>o[k]='#i'+((((S.site.theme??4)*37)+j*53)%800));await saveSite({icons:o})}
