   else if(a.dataset.act==='gmreset'){await S.db.doc('games/'+id).update({res:{}})}
   else if(a.dataset.act==='gmdel'){await S.db.doc('games/'+id).delete();LOG('🗑️ حذف فعالية')}
   else if(a.dataset.act==='ghsave'){await saveSite({gh:S.site.gh||{}});LOG('🏷️ حفظ عنوان الفعاليات');alert0('تم الحفظ ✅')}
   else if(a.dataset.act==='admsave'){await saveSite({admlbl:document.getElementById('adm_l').value.trim()||'مسؤول'});alert0('تم الحفظ ✅')}
   else if(a.dataset.act==='tbadd'){const d=S.td||{},L=S.site.tb||[];if(!(d.t||'').trim())return alert0('اكتب اسم الأيقونة');if(d.k==='url'&&!safeUrl((d.u||'').trim()))return alert0('الرابط لازم يبدأ بـ https://');if(L.length>=8)return alert0('الحد 8 أيقونات');await saveSite({tb:[...L,{id:Date.now().toString(36),ico:d.ico||'#s8',t:d.t.trim(),k:d.k==='url'?'url':'go',r:d.r||'home',u:(d.u||'').trim(),col:/^#[0-9a-f]{6}$/i.test(d.col||'')?d.col:''}]});LOG('🔝 إضافة أيقونة علوية: '+d.t.trim());S.td=null;render()}
   else if(a.dataset.act==='tbdel'){await saveSite({tb:(S.site.tb||[]).filter((_,i)=>i!==+id)})}
   else if(a.dataset.act==='tbup'){const L=(S.site.tb||[]).slice(),i=+id;if(i>0){[L[i-1],L[i]]=[L[i],L[i-1]];await saveSite({tb:L})}}
