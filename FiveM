h1,h2,h3{font-family:var(--display);margin:0;line-height:1.25;text-wrap:balance}
.muted{color:var(--muted)}
a{color:var(--accent2)}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
