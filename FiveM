 const t=e.target.closest('.tile[data-f]');if(t){S.filter=t.dataset.f}
 const tb=e.target.closest('[data-tab]');if(tb){S.tab=tb.dataset.tab;render();return}
 if(e.target.closest('[data-ul]')){try{localStorage.removeItem('rl_me')}catch(_){}S.me=null;S.acct=null;if(S._unA){S._unA();S._unA=null}render();return}
 const fo=e.target.closest('[data-fol]');if(fo&&S.me){try{const id=fo.dataset.fol,f=((S.acct&&S.acct.follows)||[]).slice(),i=f.indexOf(id);i<0?f.push(id):f.splice(i,1);await S.db.doc('accounts/'+S.me).update({follows:f})}catch(_){alert0('تعذر الحفظ')}return}
 const ts=e.target.closest('[data-tks]');if(ts){const u=ts.dataset.u,stf=isStaff(),k=ts.dataset.tks;if((u!==S.uid&&!stf)||(k==='work'&&!stf))return;try{await tkUpd(u,ts.dataset.i,t=>({...t,status:k}))}catch(_){alert0('تعذر التنفيذ')}return}
 const cd=e.target.closest('[data-cdel]');if(cd&&isStaff()){try{await S.db.doc('chat/'+cd.dataset.cdel).delete()}catch(_){alert0('تعذر الحذف')}return}
 const rm=e.target.closest('[data-room]');if(rm){S.room=rm.dataset.room;render();return}
 const a=e.target.closest('[data-act]');if(!a)return;
 if(!sessOk()){S.unlocked=false;render();return}
 sessTouch();const id=a.dataset.id;
 try{
  if(a.dataset.act==='logout'){sessEnd();S.unlocked=false;render()}
  else if(a.dataset.act==='toggle'){const c=S.channels.find(x=>x.id===id);if(!c)return;const nl=!c.live;await S.db.doc('channels/'+id).update({live:nl});
