   else if(a.dataset.act==='sxnew'){S.sd=null;render()}
   else if(a.dataset.act==='sxedit'){const s=S.sx.find(x=>x.id===id);if(s){S.sd={id:s.id,name:s.name,ico:s.ico,col:s.col,type:s.type,r:s.route,u:s.url};render();scrollTo(0,0)}}
   else if(a.dataset.act==='sxdel'){for(const g of (S.gi[id]||[]))await S.db.doc('gimgs/'+g.id).delete();await S.db.doc('sections/'+id).delete();LOG('🗑️ حذف قسم')}
   else if(a.dataset.act==='sxup'){const i=S.sx.findIndex(x=>x.id===id);if(i>0){const A=S.sx[i-1],B=S.sx[i];await S.db.doc('sections/'+A.id).update({at:B.at});await S.db.doc('sections/'+B.id).update({at:A.at})}}
   else if(a.dataset.act==='gidel'){await S.db.doc('gimgs/'+id).delete()}
   else if(a.dataset.act==='homv'||a.dataset.act==='pomv'){const h=a.dataset.act==='homv',arr=h?ordr(HODEF,S.site.ho):ordr(plAll(),S.site.po),i=arr.indexOf(id),j=i+(+a.dataset.d);if(i<0||j<0||j>=arr.length)return;[arr[i],arr[j]]=[arr[j],arr[i]];await saveSite(h?{ho:arr}:{po:arr})}
   else if(a.dataset.act==='sxmv'){const i=S.sx.findIndex(x=>x.id===id),j=i+(+a.dataset.d);if(i<0||j<0||j>=S.sx.length)return;const A=S.sx[i],B=S.sx[j];await S.db.doc('sections/'+A.id).update({at:B.at});await S.db.doc('sections/'+B.id).update({at:A.at})}
   else if(a.dataset.act==='orst'){await saveSite({ho:[],po:[]})}
   else if(a.dataset.act==='pdpub'){const d=S.pd||{};if(!d.sid)return alert0('اختر القسم');if(!imgOk(d.img))return alert0('اختر صورة');await S.db.collection('gimgs').add({sid:d.sid,img:d.img,artist:(d.artist||'').trim(),title:(d.title||'').trim(),note:(d.note||'').trim(),at:Date.now()});LOG('🖼️ نشر صورة: '+(d.artist||''));S.pd={sid:d.sid,artist:'',title:'',note:'',img:''};alert0('تم النشر ✅');render()}
   else if(a.dataset.act==='clrtk'){for(const d of S.tickets)await S.db.doc('tickets/'+d.uid).update({items:(d.items||[]).filter(i=>i.status!=='closed')})}
  else if(a.dataset.act==='iclr2'){await saveSite({icons:{},icol:{}})}
  else if(a.dataset.act==='icat'){S.icat=a.dataset.k;S.ipg=0;render()}
  else if(a.dataset.act==='icol'&&S.pick){await saveSite({icol:{...(S.site.icol||{}),[S.pick]:document.getElementById('icc').value}})}
  else if(a.dataset.act==='icolx'&&S.pick){const o={...(S.site.icol||{})};delete o[S.pick];await saveSite({icol:o})}
  else if(a.dataset.act==='rkico'){S.rkIco='#s'+a.dataset.n;render()}
