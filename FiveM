     else if(a.dataset.act==='gvdraw'){const g=S.gvs.find(x=>x.id===id);if(g)await drawG(g)}
   else if(a.dataset.act==='gvdel'){await S.db.doc('giveaways/'+id).delete();LOG('🗑️ حذف قيفاواي')}
   else if(a.dataset.act==='mute'){const m=+document.getElementById('md_'+id).value;await S.db.doc('accounts/'+id).update({mute:Date.now()+m*6e4});LOG('🔇 كتم @'+id+' لمدة '+left(m*6e4))}
   else if(a.dataset.act==='unmute'){await S.db.doc('accounts/'+id).update({mute:0});LOG('🔊 رفع كتم @'+id)}
   else if(a.dataset.act==='warn'){await addWarn(id,S.accounts.find(x=>x.id===id)||{},document.getElementById('wr_'+id).value.trim()||'بدون سبب')}
   else if(a.dataset.act==='clrw'){await S.db.doc('accounts/'+id).update({warns:[]});LOG('🧹 مسح تحذيرات @'+id)}
   else if(a.dataset.act==='ban'){const x=S.accounts.find(y=>y.id===id);await S.db.doc('accounts/'+id).update({ban:!(x&&x.ban)});LOG((x&&x.ban?'✅ فك حظر @':'⛔ حظر @')+id)}
   else if(a.dataset.act==='unmuteall'){for(const x of S.accounts)if(x.mute>Date.now())await S.db.doc('accounts/'+x.id).update({mute:0});LOG('🔊 رفع الكتم عن الجميع')}
