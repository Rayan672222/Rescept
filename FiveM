const gvHtml=()=>{const L=S.gvs.filter(g=>!g.done||Date.now()-g.at<2592e5).slice(0,4);if(!L.length)return'';return '<h2>🎁 قيفاواي</h2><div class="list">'+L.map(g=>{const en=g.entries||[],on=!g.done&&g.end>Date.now(),me=S.me&&en.includes(S.me);return `<div class="card" style="border-color:var(--accent)"><b style="font-size:1.1rem">🎁 ${esc(g.prize)}</b><div class="row"><span class="chip">🏆 ${g.winners} فائز</span><span class="chip">👥 ${en.length}</span><span class="chip">${on?'⏳ باقي '+left(g.end-Date.now()):'انتهى'}</span></div>${g.done?`<div>الفائزين: ${(g.won||[]).map(x=>'@'+esc(x)).join('، ')||'ما في مشاركين'}</div>`:on?`<button class="p" data-gj="${esc(g.id)}" ${me?'disabled':''}>${me?'✅ مشارك':'🎉 ادخل القيفاواي'}</button>`:'<div class="muted">بانتظار السحب…</div>'}</div>`}).join('')+'</div>'};
