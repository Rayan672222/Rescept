.ib b{position:absolute;top:-4px;inset-inline-start:-4px;min-width:20px;height:20px;border-radius:99px;background:var(--live);color:#fff;font-size:.7rem;display:grid;place-items:center;padding:0 4px}
.logo{width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,var(--accent),#155e75);display:grid;place-items:center;flex:none}
