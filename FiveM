.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.stats div{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:12px 4px;text-align:center;display:flex;flex-direction:column}
.stats b{font-family:var(--mono);font-size:1.5rem}
.stats span{font-size:.75rem;color:var(--muted)}

.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.chip{display:inline-flex;align-items:center;gap:6px;padding:2px 10px;border-radius:99px;background:var(--surface2);border:1px solid var(--line);font-size:.78rem;color:var(--accent2)}
.chip.live{color:#ffb3be;border-color:rgba(255,93,115,.5);background:rgba(255,93,115,.12)}
.list{display:flex;flex-direction:column;gap:10px}
.ch{display:flex;gap:12px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:12px}
.ch.on{border-color:var(--live);box-shadow:0 0 28px -10px var(--live)}
.ch .pi{width:46px;height:46px;border-radius:14px}
.ch .pi svg{width:22px;height:22px}
.ch .info{flex:1;min-width:0;overflow-wrap:anywhere}
.ch .info b{font-family:var(--display);font-size:1.05rem}
.tabs{display:flex;gap:6px;flex-wrap:wrap}
.tabs button,.btn,button.p{border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:8px 16px;font-weight:600;text-decoration:none;color:var(--text);display:inline-block}
.tabs button.on,button.p,.btn.p{background:linear-gradient(135deg,var(--accent),#0e7490);border-color:transparent;color:var(--on)}
button.sm{padding:4px 12px;font-size:.82rem;border-radius:10px}
button.bad{background:rgba(255,93,115,.15);border:1px solid rgba(255,93,115,.5);color:#ffb3be}
form{display:flex;flex-direction:column;gap:12px}
label{display:flex;flex-direction:column;gap:4px;font-size:.88rem;color:var(--muted);min-width:0}
input,select,textarea{width:100%;min-width:0;background:var(--inset);border:1px solid var(--line);border-radius:12px;padding:10px 12px}
input:focus,select:focus,textarea:focus{border-color:var(--accent2);outline:0}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
.note{border:1px dashed var(--line);border-radius:16px;padding:12px;color:var(--muted);font-size:.9rem}
.err{color:#ffb3be;font-size:.88rem;min-height:1.3em}
.al{display:flex;gap:12px;align-items:flex-start;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:12px}
.al.new{border-color:var(--accent)}
.al i{font-style:normal;font-size:1.3rem}
.al>div{flex:1;min-width:0;overflow-wrap:anywhere}

nav.bn{position:fixed;z-index:25;bottom:calc(10px + env(safe-area-inset-bottom,0px));left:max(10px,env(safe-area-inset-left,0px));right:max(10px,env(safe-area-inset-right,0px));max-width:480px;margin-inline:auto;display:flex;gap:2px;padding:6px;border-radius:var(--navr);background:color-mix(in srgb,var(--surface) 90%,transparent);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid color-mix(in srgb,var(--accent2) 30%,transparent);box-shadow:0 20px 50px -10px #000}
nav.bn a{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:8px 4px;border-radius:14px;color:var(--muted);text-decoration:none;font-size:.7rem;font-weight:600}
nav.bn a svg{width:22px;height:22px}
nav.bn a.on{color:var(--on);background:linear-gradient(135deg,var(--accent),#0e7490)}
.themes{display:grid;grid-template-columns:repeat(auto-fill,minmax(104px,1fr));gap:8px}
.th{display:flex;flex-direction:column;gap:6px;padding:8px;border-radius:12px;border:1px solid var(--line);background:var(--surface);font-size:.74rem;text-align:start;color:var(--text)}
.th i{display:block;height:28px;border-radius:8px;border:1px solid var(--line)}
.th.on{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent)}
button.sm{color:var(--text)}

.card,.tile,.ch,.al,.stats div,.hero,.top,nav.bn{border-width:var(--bw);box-shadow:var(--sh)}
.card{padding:var(--pad)}
html[data-hc="1"] .hero{align-items:center;text-align:center}
