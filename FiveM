   else if(a.dataset.act==='bkrest'){await saveSite(JSON.parse(document.getElementById('bk_t').value));alert0('تمت الاستعادة ✅')}
   else if(a.dataset.act==='fxg'){S.fxg=+id;render()}
   else if(a.dataset.act==='fxsave'){await saveSite({fx:S.site.fx||{}});LOG('🎛️ حفظ إعدادات مركز التحكم');alert0('تم الحفظ ✅')}
   else if(a.dataset.act==='fxreset'){const gi=id==='all'?-1:+id,f=S.site.fx||{};Object.keys(f).forEach(k=>{if(gi<0||(gi===0?k[0]==='g':k.startsWith((gi-1)+'_')))delete f[k]});S.site.fx=f;applyFx();render()}
