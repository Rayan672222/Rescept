 }catch(err){alert0(err&&err.code==='invalid_argument'?'ما عندك صلاحية الكتابة في قاعدة البيانات (تحتاج صلاحية محرر على الصفحة).':'تعذر التنفيذ')}
});
const alert0=m=>{const d=document.createElement('div');d.className='note';d.setAttribute('role','alert');d.textContent=m;d.style.cssText='position:fixed;top:calc(80px + env(safe-area-inset-top,0px));inset-inline:16px;z-index:40;background:var(--surface2)';document.body.append(d);setTimeout(()=>d.remove(),4000)};

document.addEventListener('focusin',e=>{if(e.target.closest&&e.target.closest('form'))S._skip=true});
document.addEventListener('focusout',()=>setTimeout(()=>{if(!document.activeElement||!document.activeElement.closest||!document.activeElement.closest('form')){if(S._skip&&!S.busy){S._skip=false;if(S._pending){S._pending=false;render()}}}},200));

const submitH=async e=>{e.preventDefault();const id=e.target.id,v=i=>(document.getElementById(i)||{}).value||'';
 try{
  if(id==='tkForm'){if(!S.uid)return;const it=((S.myTk&&S.myTk.items)||[]).slice(-19);it.push({id:Date.now().toString(36),subject:v('tk_s').trim(),text:v('tk_t').trim(),status:'open',reply:'',at:Date.now()});
   await S.db.doc('tickets/'+S.uid).set({name:(S.acct&&S.acct.name)||S.me||'',me:S.me||'',items:it});e.target.reset();return}
  if(e.target.dataset.f==='tkm'){const u=e.target.dataset.u,stf=isStaff(),tx=e.target.elements.msg.value.trim();if(!tx||(u!==S.uid&&!stf))return;
   await tkUpd(u,e.target.dataset.i,t=>({...t,msgs:[...(t.msgs||[]).slice(-40),{by:stf&&u!==S.uid?((S.acct&&S.acct.name)||'الإدارة'):'',text:tx,at:Date.now(),staff:stf&&u!==S.uid?1:0}]}));e.target.reset();return}
  if(id==='chatForm'){const tx=v('ch_t').trim();if(!tx||!S.me||!canChat('w'))return;if(!chk(tx))return;await S.db.collection('chat').add({room:S.room||'main',name:(S.acct&&S.acct.name)||S.me,me:S.me,rank:(S.unlocked&&sessOk()?'مسؤول':(S.acct&&S.acct.rank)||''),text:tx,at:Date.now()});e.target.reset();return}
  if(id==='regForm'){const er=$('#rerr'),u=v('ru').trim().toLowerCase(),pw=v('rp');
   if(!/^[a-z0-9_]{3,20}$/.test(u))return er.textContent='اسم المستخدم: حروف إنجليزية وأرقام و _ فقط (3 إلى 20).';
   if(pw.length<8)return er.textContent='كلمة السر 8 أحرف على الأقل.';
   if(u==='cc')return er.textContent='هذا الاسم محجوز.';
   er.textContent='جارِ الإنشاء…';
   if((await S.db.doc('accounts/'+u).get()).exists)return er.textContent='الاسم مستخدم، جرّب اسم ثاني.';
   const salt=[...crypto.getRandomValues(new Uint8Array(16))].map(x=>x.toString(16).padStart(2,'0')).join('');
   try{await S.db.doc('accounts/'+u).set({name:v('rn').trim()||u,salt,iter:120000,hash:await derive(u,pw,salt,120000),follows:[],at:Date.now()})}
   catch(x){return er.textContent=(x&&x.code==='invalid_argument')?'ما عندك صلاحية إنشاء حساب. لازم تكون مدعو للصفحة بصلاحية مساهم.':'تعذر إنشاء الحساب.'}
   loginAs(u);return}
  if(id==='logForm'){const er=$('#gerr'),u=v('gu').trim().toLowerCase();er.textContent='جارِ التحقق…';
   const sn=await S.db.doc('accounts/'+u).get(),d=sn.exists?sn.data():null;let ok=false;
   if(d)ok=eq(await derive(u,v('gp'),d.salt,d.iter),d.hash);
   if(!ok){await new Promise(r=>setTimeout(r,900));return er.textContent='اسم المستخدم أو كلمة السر غلط.'}
   loginAs(u);return}
  if(id==='loginForm'){
   const lk=lockInfo();if(lk.until>Date.now())return;
   const er=$('#lerr');er.textContent='جارِ التحقق…';
   const snap=await S.db.doc('secure/auth').get();const d=snap.exists?snap.data():null;
   let ok=false;if(d){const h=await derive(v('lu'),v('lp'),d.salt,d.iter);ok=eq(h,d.hash)}
   if(ok){store.set('rl_lock',JSON.stringify({n:0,until:0}));S.unlocked=true;sessTouch();S._skip=false;render()}
   else{const n=(lk.n||0)+1;store.set('rl_lock',JSON.stringify({n:n>=5?0:n,until:n>=5?Date.now()+5*6e4:0}));
    await new Promise(r=>setTimeout(r,800+n*400));er.textContent=n>=5?'تم القفل 5 دقائق بعد محاولات خاطئة.':'اسم المستخدم أو كلمة السر غلط.';$('#lp').value=''}
   return}
  if(!sessOk()){S.unlocked=false;render();return}sessTouch();
  if(id==='chForm'){const u=safeUrl(v('c_u').trim());if(!u)return alert0('الرابط لازم يبدأ بـ https://');
   await S.db.collection('channels').add({name:v('c_n').trim(),platform:v('c_p'),url:u,note:v('c_t').trim(),live:false,at:Date.now()});e.target.reset()}
  else if(id==='txtForm'){const nav={};['home','channels','alerts','tickets','chat','account','admin'].forEach(k=>{const x=v('t_n_'+k).trim();if(x)nav[k]=x});await saveSite({ct:v('t_ct').trim(),nav,ann:v('t_an').trim(),annu:safeUrl(v('t_au').trim()),annc:hx(v('t_ac'))});alert0('تم الحفظ')}
    else if(id==='gvForm'){const p=v('gv_p').trim();await S.db.collection('giveaways').add({prize:p,winners:Math.max(1,+v('gv_w')||1),end:Date.now()+(+v('gv_m')||60)*6e4,entries:[],won:[],done:false,at:Date.now()});LOG('🎁 قيفاواي جديد: '+p);e.target.reset()}
  else if(id==='fltForm'){await saveSite({slow:+v('f_sl')||0,clock:v('f_lk')==='1',bw:v('f_bw').split(/[,،\n]/).map(x=>x.trim().toLowerCase()).filter(Boolean),maint:v('f_mt').trim(),aw:+v('f_aw')||0,am:+v('f_am')||60,pin:v('f_pin').trim()});LOG('🛡️ تحديث إعدادات الحماية');alert0('تم الحفظ ✅')}
  else if(id==='roomForm'){await S.db.collection('rooms').add({name:v('rm_n').trim(),at:Date.now()});e.target.reset()}
  else if(id==='alForm'){await S.db.collection('alerts').add({kind:v('a_k'),channel:v('a_c').trim(),text:v('a_t').trim(),at:Date.now()});e.target.reset()}
  else if(id==='lookForm'){const f=v('s_f'),c=v('s_c');await saveSite({name:v('s_n').trim(),tag:v('s_t').trim(),ht:v('s_ht').trim(),ey:v('s_ey').trim(),sub:v('s_sub').trim(),font:FONTS.includes(f)?f:'',nfont:NF.includes(v('s_nf'))?v('s_nf'):'',accent:v('s_ce')==='1'&&/^#[0-9a-f]{6}$/i.test(c)?c:''});alert0('تم الحفظ')}
  else if(id==='icForm'){const I={};['home','channels','alerts','account','admin','kick','youtube','telegram','x'].forEach(k=>{const x=v('ic_'+k).trim();if(x)I[k]=x});await saveSite({icons:I});alert0('تم الحفظ')}
  else if(id==='rkForm'){const c=v('rk_c'),ik=S.rkIco||'';S.rkIco='';await S.db.collection('ranks').add({name:v('rk_n').trim(),emoji:v('rk_e').trim(),ico:ik,color:/^#[0-9a-f]{6}$/i.test(c)?c:'#f5b84b',at:Date.now()});e.target.reset()}
  else if(e.target.dataset.f==='chlive'){const f=e.target.elements,lu=f.lu.value.trim();if(lu&&!safeUrl(lu))return alert0('الرابط لازم يبدأ بـ https://');await S.db.doc('channels/'+e.target.dataset.id).update({name:f.n.value.trim()||'—',ld:f.ld.value.trim(),lu});alert0('تم الحفظ')}
  else if(e.target.dataset.f==='tkr'){const d=S.tickets.find(x=>x.uid===e.target.dataset.u);if(!d)return;const rp=e.target.elements.reply.value.trim();const items=(d.items||[]).map(t=>t.id===e.target.dataset.i?{...t,reply:rp}:t);await S.db.doc('tickets/'+d.uid).update({items});alert0('أرسل الرد')}
 }catch(err){alert0(err&&err.code==='invalid_argument'?'ما عندك صلاحية الكتابة في قاعدة البيانات (تحتاج صلاحية محرر على الصفحة).':'تعذر التنفيذ')}
};
document.addEventListener('submit',e=>{S.busy=true;submitH(e).finally(()=>{S.busy=false})});
function loginAs(u){S.me=u;try{localStorage.setItem('rl_me',u)}catch(_){}S._skip=false;watchMe();render()}
function watchMe(){if(!S.db||!S.me)return;if(S._unA)S._unA();S._unA=S.db.doc('accounts/'+S.me).onSnapshot(sn=>{S.acct=sn.exists?sn.data():null;if(isStaff()&&!S._tkU&&!S.can)S._tkU=S.db.collection('tickets').limit(300).onSnapshot(t=>{S.tickets=t.docs.map(d=>({uid:d.id,...d.data()}));softRender()},()=>{});softRender()},()=>{})}
document.addEventListener('change',async e=>{const t=e.target,d=t.dataset||{};
 try{
  if(d.role!==undefined){if(!sessOk())return;await S.db.doc('accounts/'+d.role).update({rank:t.value})}
  else if(d.upapp&&t.files&&t.files[0]){if(!sessOk())return;S.appN=document.getElementById('ap_n').value;S.appC=document.getElementById('ap_c').value;S.appImg=await toData(t.files[0],96,'image/png');render()}
  else if(d.appc!==undefined){if(!sessOk())return;await saveSite({apps:(S.site.apps||[]).map(x=>x.id===d.appc?{...x,col:hx(t.value)}:x)})}
  else if(d.up&&t.files&&t.files[0]){if(!sessOk())return;const lg=d.up==='logo',u=await toData(t.files[0],lg?256:1000,lg?'image/png':'image/jpeg');
   if(u.length>230000)return alert0('الصورة كبيرة، جرّب صورة أصغر.');await saveSite({[d.up]:u});alert0('تم الرفع')}
 }catch(_){alert0('تعذر التنفيذ')}});
setInterval(()=>{if(S.unlocked&&!sessOk()){S.unlocked=false;render()}},30000);

/* ---------- boot ---------- */
(async function(){
 const h=location.hash.slice(1);S.route=ROUTES.includes(h)?h:'home';
 render();
 try{
  const [db,user]=await Promise.all([claude.use('db'),claude.use('user')]);
  S.db=db;
  S.can=!!(user&&user.canEdit&&await user.canEdit());
  if(!db){S.ready=true;render();return}
  const sub=(q,fn)=>q.onSnapshot(sn=>{fn(sn);S.ready=true;softRender()},()=>{S.ready=true;render()});
  sub(db.collection('channels').orderBy('at','asc').limit(300),sn=>{S.channels=sn.docs.map(d=>({id:d.id,...d.data()}))});
  sub(db.collection('alerts').orderBy('at','desc').limit(100),sn=>{S.alerts=sn.docs.map(d=>({id:d.id,...d.data()}))});
  try{S.uid=user&&user.id?await user.id():null}catch(_){S.uid=null}
  sub(db.collection('ranks').limit(100),sn=>{S.ranks=sn.docs.map(d=>({id:d.id,...d.data()}))});
  sub(db.collection('rooms').orderBy('at','asc').limit(30),sn=>{S.rooms=sn.docs.map(d=>({id:d.id,...d.data()}))});
  db.collection('chat').orderBy('at','desc').limit(300).onSnapshot(sn=>{S.chat=sn.docs.map(d=>({id:d.id,...d.data()}));chatPaint()},()=>{});
  sub(db.collection('giveaways').orderBy('at','desc').limit(30),sn=>{S.gvs=sn.docs.map(d=>({id:d.id,...d.data()}))});sub(db.collection('sections').orderBy('at','asc').limit(40),sn=>{S.sx=sn.docs.map(d=>({id:d.id,...d.data()}))});sub(db.collection('games').orderBy('at','desc').limit(30),sn=>{S.gm=sn.docs.map(d=>({id:d.id,...d.data()}))});if(S.can){sub(db.collection('logs').orderBy('at','desc').limit(60),sn=>{S.logs=sn.docs.map(d=>({id:d.id,...d.data()}))});sub(db.collection('accounts').limit(500),sn=>{S.accounts=sn.docs.map(d=>({id:d.id,...d.data()}))});sub(db.collection('tickets').limit(300),sn=>{S.tickets=sn.docs.map(d=>({uid:d.id,...d.data()}))})}
  if(S.uid)db.doc('tickets/'+S.uid).onSnapshot(sn=>{S.myTk=sn.exists?sn.data():null;softRender()},()=>{});
  watchMe();
  db.doc('site/main').onSnapshot(sn=>{if(sn.exists&&sn.data().tag)S.site={...S.site,...sn.data()};softRender()},()=>{});
  setTimeout(()=>{if(!S.ready){S.ready=true;render()}},10000);
 }catch(_){S.ready=true;render()}
})();
</script>

